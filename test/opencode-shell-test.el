(ert-deftest opencode-shell-lost-snapshot-expires-and-ignores-late-callback ()
  (with-temp-buffer
    (opencode-shell-mode)
    (setq opencode-shell--generation 7)
    (let (requests timers (failures 0) accepted)
      (cl-letf (((symbol-function 'opencode-shell--request)
                 (lambda (_method _path callback &optional _body _params error-callback)
                   (push (list callback error-callback) requests)))
                ((symbol-function 'run-at-time)
                 (lambda (_delay _repeat callback &rest args)
                   (push (cons callback args) timers))))
        (opencode-shell--guarded-request
         'messages "GET" "/message" (lambda (_) (push 'old accepted))
         nil (lambda () (cl-incf failures)))
        (should (= (length requests) 1))
        (apply (caar timers) (cdar timers))
        (should (= failures 1))
        (should-not (alist-get 'messages opencode-shell--in-flight))
        (opencode-shell--guarded-request
         'messages "GET" "/message" (lambda (_) (push 'new accepted)))
        (should (= (length requests) 2))
        (funcall (car (cadr requests)) nil)
        (funcall (cadr (cadr requests)))
        (should (alist-get 'messages opencode-shell--in-flight))
        (should (= failures 1))
        (should-not accepted)
        (funcall (car (car requests)) nil)
        (should (equal accepted '(new)))
        (should-not (alist-get 'messages opencode-shell--in-flight))))))

