          (opencode-shell-async--schedule-reconnect key)
          (should (= (plist-get runtime :backoff) 4)))
      (remhash key opencode-shell-async--runtimes))))

(ert-deftest opencode-shell-sse-rejects-unsafe-and-conflicting-config ()
