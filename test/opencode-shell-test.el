             (overlays-in (point-min) (point-max))))

(ert-deftest opencode-shell-turn-navigation-uses-live-prompt-markers ()
  (with-temp-buffer
    (opencode-shell-mode)
    (let ((turns (list (opencode-shell--make-turn :id "first" :user "first"
                                                   :assistant "one" :status 'complete)
                       (opencode-shell--make-turn :id "second" :user "second"
                                                   :assistant "two" :status 'complete)
                       (opencode-shell--make-turn :id "third" :user "third"
                                                   :assistant "three" :status 'complete))))
      (setq opencode-shell--turns turns)
      (opencode-shell--render-turns)
      (let ((first (opencode-shell--turn-user-begin (nth 0 turns)))
            (second (opencode-shell--turn-user-begin (nth 1 turns)))
            (third (opencode-shell--turn-user-begin (nth 2 turns))))
        (goto-char first)
        (opencode-shell--next-turn)
        (should (= (point) second))
        (opencode-shell--next-turn)
        (should (= (point) third))
        (goto-char (opencode-shell--turn-response-begin (nth 2 turns)))
        (opencode-shell--previous-turn)
        (should (= (point) third))
        (goto-char opencode-shell--composer-start)
        (opencode-shell--previous-turn)
        (should (= (point) third))
        (set-marker second nil)
        (goto-char first)
        (opencode-shell--next-turn)
        (should (= (point) third))
        (goto-char first)
        (should-error (opencode-shell--previous-turn) :type 'user-error)
        (should (= (point) first))
        (goto-char third)
        (opencode-shell--next-turn)
        (should (= (point) opencode-shell--composer-start))
        (opencode-shell--previous-turn)
        (should (= (point) third))))))

